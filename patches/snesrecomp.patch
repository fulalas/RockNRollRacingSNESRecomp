+    snes_host_clock_presentation_done(&unblocked, now);
+    double deadline = snes_host_clock_next_deadline(&unblocked);
+    if (deadline > now) now = deadline;
+  }
+  assert(unblocked.presentations >= 59 && unblocked.presentations <= 62);
+
+  snes_host_clock_set_vsync(&unblocked, 0);
+  snes_host_clock_presentation_done(&unblocked, now);
+  assert(unblocked.missed_presentations <= 1);
+
