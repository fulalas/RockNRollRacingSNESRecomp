+    SnesHostClock framed;
+    snes_host_clock_reset(&framed, 0, sim, 60.0 * m);
+    snes_host_clock_set_vsync(&framed, 1 / (60.0 * m));
+    snes_host_clock_set_frame_lock(&framed, m);
+    now = 0;
+    unsigned long long sims_before = 0;
+    for (int i = 0; i < 600; ++i) {
+      while (snes_host_clock_simulation_due(&framed, now))
